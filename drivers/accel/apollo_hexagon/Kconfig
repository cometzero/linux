config DRM_ACCEL_APOLLO_HEXAGON
	bool "Apollo Hexagon DRM accel driver"
	depends on DRM_ACCEL
	depends on OF
	depends on HAS_DMA
	depends on ARM64 || COMPILE_TEST
	select IOMMU_API
	help
	  Build the Apollo Hexagon platform driver as a DRM compute
	  accelerator exposed through /dev/accel/accel*.  The driver binds
	  the apollo,hexagon-ip device behind the ARM SMMUv3 path and exposes
	  the repo-local CNN, vector-add, and DMA stress submit ABI as DRM
	  driver ioctls.

config DRM_ACCEL_APOLLO_HEXAGON_SELFTEST
	bool "Apollo Hexagon DRM accel SMMUv3 bring-up selftests"
	depends on DRM_ACCEL_APOLLO_HEXAGON
	help
	  Run Apollo Hexagon bring-up checks from the driver probe path.  These
	  checks exercise QBox-specific firmware DMA markers, SMMUv3 descriptor
	  staging, architected queues, ATS/PRI/fault paths, and RIL TLBI range
	  commands.

	  Leave this disabled for the normal runtime driver.  Generic IOMMU DMA
	  coverage should use the drivers/iommu/iommu-test.c runtime test driver
	  instead.
