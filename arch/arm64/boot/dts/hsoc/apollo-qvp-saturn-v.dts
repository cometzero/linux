/* Keep every reserved buffer and its remoteproc/mailbox consumer available. */
&si_cl1 {
	status = "okay";
};

&si_remoteproc {
	status = "okay";
};

&si_cl1_rproc_rsctbl {
	status = "okay";
};

&si_cl1_vdev0vring0 {
	status = "okay";
};

&si_cl1_vdev0vring1 {
	status = "okay";
};

&si_cl1_vdev0buffer {
	status = "okay";
};

&si_cl1_mbox_rproc_tx {
	status = "okay";
};

&si_cl1_mbox_rproc_rx {
	status = "okay";
