/dts-v1/;

#include "apollo-qvp.dtsi"
#include <dt-bindings/gpio/gpio.h>

/*
 * Existing QVP population; Saturn-V schematic parity is unverified.
 * TPS6594 and its regulators/GPIO remain owned by SI CL0 firmware.
 */
/ {
	model = "Apollo QVP";
	compatible = "arm,apollo-qvp", "arm,zena-css", "arm,vexpress";

	aliases {
		i2c0 = &dw_i2c0;
		i2c1 = &dw_i2c1;
		i2c2 = &dw_i2c2;
		i2c3 = &dw_i2c3;
		i2c4 = &dw_i2c4;
		i2c5 = &dw_i2c5;
		rtc0 = &{/soc/rtc@300d0000};
		serial0 = &dw_uart0;
		serial1 = &dw_uart1;
		serial2 = &dw_uart2;
		serial3 = &dw_uart3;
		spi0 = &dw_spi0;
		spi1 = &dw_spi1;
		spi2 = &dw_spi2;
		spi3 = &dw_spi3;
	};

	chosen {
		stdout-path = &soc_serial0;
	};

	memory@80000000 {
		device_type = "memory";

		/* ~2GB mapped at 2GB, another 2GB at 2TB */
		reg = <0x00000000 0x80000000 0x00000000 0x7f000000>,
		      <0x00000200 0x00000000 0x00000000 0x80000000>;
	};
};

&soc_serial0 {
	status = "okay";
};

&smd_gpio {
	gpio-line-names =
		"smd-gpio0", "smd-gpio1", "smd-gpio2", "smd-gpio3",
		"smd-gpio4", "smd-gpio5", "smd-gpio6", "smd-gpio7";

	status = "okay";
};

&pcie_epc {
	status = "okay";
};

&pcie {
	status = "okay";
};

&smmu {
	status = "okay";
};

&dma350_0 {
	status = "okay";
};

&dma350_1 {
	status = "okay";
};

&dw_i2c0 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;

	status = "okay";

	eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <8>;
	};

	/* Three independent 24C02 targets share this controller. */
	eeprom@51 {
		compatible = "atmel,24c02";
		reg = <0x51>;
		pagesize = <8>;
	};

	eeprom@52 {
		compatible = "atmel,24c02";
		reg = <0x52>;
		pagesize = <8>;
	};

	board_gpio: gpio@74 {
		compatible = "nxp,pca9539";
		reg = <0x74>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&smd_gpio>;
		interrupts = <1 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&smd_gpio 0 GPIO_ACTIVE_LOW>;
		gpio-line-names =
			"pca9539-loop-out0", "pca9539-loop-in1",
			"pca9539-gpio2", "pca9539-gpio3",
			"pca9539-gpio4", "pca9539-gpio5",
			"pca9539-gpio6", "pca9539-gpio7",
			"pca9539-loop-out8", "pca9539-loop-in9",
			"pca9539-gpio10", "pca9539-gpio11",
			"pca9539-gpio12", "pca9539-gpio13",
			"pca9539-gpio14", "pca9539-gpio15";
	};
};

&dw_i2c1 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;

	status = "okay";

	eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <8>;
	};
};

