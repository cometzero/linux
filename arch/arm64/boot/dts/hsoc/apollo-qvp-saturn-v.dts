&dw_spi0 {
	num-cs = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins>;

	status = "okay";
};

&dw_spi1 {
	num-cs = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;

	status = "okay";
};

&dw_spi2 {
	num-cs = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_pins>;

	status = "okay";
};

&dw_spi3 {
	num-cs = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi3_pins>;

	status = "okay";
};

&dw_uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;

	status = "okay";
};

&dw_uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;

	status = "okay";
};

&dw_uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pins>;

	status = "okay";
